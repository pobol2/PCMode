{
  "IndentSize": 4,
  "IndentWithTabs": false,
  "AttributesTolerance": 2,
  "KeepFirstAttributeOnSameLine": true,
  "MaxAttributeCharactersPerLine": 0,
  "MaxAttributesPerLine": 1,
  "NewlineExceptions": "x:Class,xmlns,xmlns:x",
  "PutEndingBracketOnNewLine": false,
  "RemoveEndingSpace": false,
  "SpaceBeforeClosingSlash": true,
  "RootElementLineBreakRule": 0,
  "ReorderVSM": 0,
  "ReorderGridChildren": false,
  "ReorderCanvasChildren": false,
  "ReorderSetters": 0,
  "EnableAttributeReordering": false,
  "FormatMarkupExtension": true,
  "NoNewLineMarkupExtensions": "x:Bind, Binding, StaticResource, DynamicResource, TemplateBinding",
  "ThicknessSeparator": 0,
  "ThicknessAttributes": "",
  "FormatOnSave": true,
  "CommentPadding": 1,
  "CommentSpaces": 1,
  "RemoveDesignTimeReferences": false,
  "IgnoreDesignTimeReferencePrefix": false,
  "SuppressProcessing": false,
  "KeepFirstAttributeOnSameLineForFirstLineOnly": false
}
