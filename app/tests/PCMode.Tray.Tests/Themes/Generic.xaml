<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PCMode.Tray.UI.Framework;assembly=PCMode.Tray"
    xmlns:fixtures="clr-namespace:PCMode.Tray.Tests.UI.Construction.Fixtures">

    <!--
        The fixture blocks' default Layouts, found by WPF's theme lookup from
        FunctionalBlock's DefaultStyleKey. A Layout names the regions its block
        declares and nothing else; there is no identity to repeat.
    -->

    <Style TargetType="{x:Type fixtures:FixtureRootBlock}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type fixtures:FixtureRootBlock}">
                    <StackPanel>
                        <controls:Region
                            x:Name="PART_HeaderRegion"
                            Content="{TemplateBinding Header}" />
                        <controls:RepeatedRegion
                            x:Name="PART_ItemsRegion"
                            ItemsSource="{TemplateBinding Items}" />
                        <controls:Region
                            x:Name="PART_DetailRegion"
                            Content="{TemplateBinding Detail}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type fixtures:FixtureDetailBlock}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type fixtures:FixtureDetailBlock}">
                    <StackPanel>
                        <controls:Region
                            x:Name="PART_PrimaryRegion"
                            Content="{TemplateBinding Primary}" />
                        <controls:Region
                            x:Name="PART_SecondaryRegion"
                            Content="{TemplateBinding Secondary}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type fixtures:FixtureStrictBlock}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type fixtures:FixtureStrictBlock}">
                    <controls:Region
                        x:Name="PART_OnlyRegion"
                        Content="{TemplateBinding Only}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Deliberately supplies nothing: the block declares a region this
         template never names, which is the missing-region case. -->
    <Style TargetType="{x:Type fixtures:FixtureUnsatisfiableBlock}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type fixtures:FixtureUnsatisfiableBlock}">
                    <StackPanel />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
