<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The picker's behaviour, checked without drawing anything.

    Plain net10.0, like the library it tests. These run on any machine, need no
    desktop, no monitor and no controller, and cannot accidentally start
    depending on one.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PCMode.Picker.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PCMode.Picker\PCMode.Picker.csproj" />
  </ItemGroup>
</Project>
