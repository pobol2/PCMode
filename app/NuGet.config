<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Scoped to this directory on purpose.

    This machine has no package sources configured globally, and adding one
    there would be a change to somebody's development environment rather than
    to this project. Declaring the source here keeps the build reproducible for
    anyone who clones the repository, and leaves everything outside app/ alone.

    clear first, so an inherited source from a parent configuration cannot
    silently change where these packages come from.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
