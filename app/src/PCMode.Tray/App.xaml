<Application x:Class="PCMode.Tray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Framework/Layout/Styles.xaml" />
                <ResourceDictionary Source="Framework/Layout/PageShellLayout.xaml" />
                <ResourceDictionary Source="Framework/Layout/ComponentLayout.xaml" />
                <ResourceDictionary Source="Framework/Layout/ConfigurationPageLayout.xaml" />
                <ResourceDictionary Source="Platform/Themes/Light.xaml" />
                <ResourceDictionary Source="Platform/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>