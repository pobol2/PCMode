<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:construction="clr-namespace:PCMode.Tray.UI.Framework"
                    xmlns:tree="clr-namespace:PCMode.Tray.UI.Tree">
    <!-- The page owns only the generic selector/editor/footer branches. -->
    <Style TargetType="{x:Type tree:ConfigurationPageBlock}">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tree:ConfigurationPageBlock}">
                    <Grid Margin="{DynamicResource PageMargin}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <construction:Region x:Name="PART_HeaderRegion" Grid.Row="0">
                            <construction:FinalUiComponent>
                                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource PageTitleStyle}" />
                            </construction:FinalUiComponent>
                        </construction:Region>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource ConfigurationSelectorWidth}" />
                                <ColumnDefinition Width="{StaticResource ConfigurationColumnGap}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <construction:Region x:Name="PART_SelectorRegion" Content="{TemplateBinding Selector}" />

                            <ScrollViewer Grid.Column="2"
                                          Style="{StaticResource PageScrollStyle}"
                                          IsEnabled="{Binding IsBusy, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource InverseBool}}">
                                <construction:Region x:Name="PART_EditorRegion"
                                                     HorizontalContentAlignment="Stretch"
                                                     VerticalContentAlignment="Stretch"
                                                     Content="{TemplateBinding Editor}" />
                            </ScrollViewer>
                        </Grid>

                        <construction:Region x:Name="PART_FooterRegion"
                                             Grid.Row="2"
                                             Margin="{StaticResource PageFooterMargin}">
                            <construction:FinalUiComponent>
                                <StackPanel Style="{StaticResource ConfigurationPageFooterStyle}">
                                    <TextBlock Text="{TemplateBinding ValidationProblem}"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               MaxWidth="360"
                                               Visibility="{TemplateBinding ValidationProblem, Converter={StaticResource StringToVisibility}}" />
                                    <Button Content="Discard changes"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{TemplateBinding DiscardCommand}" />
                                    <Button Content="Save"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{TemplateBinding SaveCommand}" />
                                </StackPanel>
                            </construction:FinalUiComponent>
                        </construction:Region>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowFooter" Value="False">
                            <Setter TargetName="PART_FooterRegion" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
