<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:construction="clr-namespace:PCMode.Tray.UI.Framework"
    xmlns:tree="clr-namespace:PCMode.Tray.UI.Tree">

    <Style TargetType="{x:Type tree:EditorSectionBlock}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tree:EditorSectionBlock}">

                    <Border
                        x:Name="SectionChrome"
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,0,12">

                        <StackPanel>

                            <!-- Header -->
                            <construction:Region
                            x:Name="PART_HeaderRegion">
                            <construction:FinalUiComponent>
                                <Grid x:Name="HeaderRow" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                                    <ToggleButton
                                        x:Name="CollapseButton"
                                        Width="24"
                                        Height="24"
                                        Margin="0,0,8,0"
                                        Content="▾"
                                        IsChecked="{Binding IsExpanded,
                                            RelativeSource={RelativeSource TemplatedParent},
                                            Mode=TwoWay}" />

                                    <TextBlock
                                        Text="{TemplateBinding Title}"
                                        Style="{StaticResource SectionTitleStyle}"
                                        Margin="0"
                                        VerticalAlignment="Center" />

                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                                    <Button
                                        x:Name="HeaderCommandButton"
                                        Content="{TemplateBinding HeaderCommandLabel}"
                                        Command="{TemplateBinding HeaderCommand}"
                                        Style="{StaticResource CompactSecondaryButtonStyle}"
                                        Margin="0,0,8,0" />

                                    <Button
                                        x:Name="RenameButton"
                                        Content="Rename"
                                        Command="{TemplateBinding RenameCommand}"
                                        Style="{StaticResource CompactSecondaryButtonStyle}"
                                        Margin="0,0,8,0" />

                                    <Button
                                        x:Name="DuplicateButton"
                                        Content="Duplicate"
                                        Command="{TemplateBinding DuplicateCommand}"
                                        Style="{StaticResource CompactSecondaryButtonStyle}"
                                        Margin="0,0,8,0" />

                                    <Button
                                        x:Name="DeleteButton"
                                        Content="Delete"
                                        Command="{TemplateBinding DeleteCommand}"
                                        Style="{StaticResource CompactSecondaryButtonStyle}"
                                        Margin="0,0,8,0" />

                                    <Button
                                        x:Name="ActivateButton"
                                        Content="{TemplateBinding ActivateLabel}"
                                        Command="{TemplateBinding ActivateCommand}"
                                        Style="{StaticResource CompactSecondaryButtonStyle}" />

                                </StackPanel>

                            </Grid>
                            </construction:FinalUiComponent>
                            </construction:Region>

                            <Border
                                x:Name="Separator"
                                Height="1"
                                Margin="0,0,0,12"
                                Background="{DynamicResource DividerBrush}" />

                            <!-- The actual section content -->
                            <construction:Region
                                x:Name="PART_ContentRegion"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">

                                <construction:FinalUiComponent
                                    Content="{TemplateBinding Content}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />

                            </construction:Region>

                        </StackPanel>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- A non-collapsible section simply has no toggle. -->
                        <Trigger Property="IsCollapsible" Value="False">
                            <Setter
                                TargetName="CollapseButton"
                                Property="Visibility"
                                Value="Collapsed" />
                        </Trigger>

                        <!-- Collapsed section -->
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter
                                TargetName="PART_ContentRegion"
                                Property="Visibility"
                                Value="Collapsed" />

                            <Setter
                                TargetName="Separator"
                                Property="Visibility"
                                Value="Collapsed" />
                        </Trigger>

                        <!-- No entity actions -->
                        <Trigger Property="ShowEntityActions" Value="False">
                            <Setter TargetName="RenameButton"
                                    Property="Visibility"
                                    Value="Collapsed" />
                            <Setter TargetName="DuplicateButton"
                                    Property="Visibility"
                                    Value="Collapsed" />
                            <Setter TargetName="DeleteButton"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>

                        <!-- No activate action -->
                        <Trigger Property="ShowActivate" Value="False">
                            <Setter TargetName="ActivateButton"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>

                        <!-- No custom header command -->
                        <Trigger Property="HeaderCommandLabel" Value="">
                            <Setter TargetName="HeaderCommandButton"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>

                        <!-- Content only, no card/header chrome -->
                        <Trigger Property="ShowChrome" Value="False">
                            <Setter TargetName="HeaderRow"
                                    Property="Visibility"
                                    Value="Collapsed" />

                            <Setter TargetName="Separator"
                                    Property="Visibility"
                                    Value="Collapsed" />

                            <Setter TargetName="SectionChrome"
                                    Property="Padding"
                                    Value="0" />

                            <Setter TargetName="SectionChrome"
                                    Property="BorderThickness"
                                    Value="0" />

                            <Setter TargetName="SectionChrome"
                                    Property="Background"
                                    Value="Transparent" />
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>