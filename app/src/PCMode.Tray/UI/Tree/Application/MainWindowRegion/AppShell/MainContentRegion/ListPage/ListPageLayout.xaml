<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:construction="clr-namespace:PCMode.Tray.UI.Framework"
    xmlns:tree="clr-namespace:PCMode.Tray.UI.Tree">

    <!-- The one place a list page's title/scroll/footer chrome is decided.
         A feature supplies only Title and the content for each region. -->
    <Style TargetType="{x:Type tree:ListPageBlock}">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tree:ListPageBlock}">
                    <Grid Margin="{DynamicResource PageMargin}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="{TemplateBinding Title}"
                                Style="{StaticResource PageTitleStyle}" />

                            <construction:Region
                                x:Name="PART_HeaderRegion"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Margin="16,0,0,0">
                                <construction:FinalUiComponent Content="{TemplateBinding Header}" />
                            </construction:Region>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollStyle}">
                            <construction:Region
                                x:Name="PART_ContentRegion"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                                <construction:FinalUiComponent
                                    Content="{TemplateBinding Content}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                            </construction:Region>
                        </ScrollViewer>

                        <construction:Region x:Name="PART_FooterRegion" Grid.Row="2">
                            <construction:FinalUiComponent Content="{TemplateBinding Footer}" />
                        </construction:Region>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="PART_HeaderRegion" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="PART_FooterRegion" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
