<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:construction="clr-namespace:PCMode.Tray.UI.Framework"
    xmlns:tree="clr-namespace:PCMode.Tray.UI.Tree">

    <!-- The shell owns only the two generic structural branches and their arrangement. -->
    <Style TargetType="{x:Type tree:AppShellBlock}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tree:AppShellBlock}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <construction:Region
                            x:Name="PART_NavigationRegion"
                            Grid.Column="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{TemplateBinding Navigation}" />

                        <Border
                            Grid.Column="1"
                            Background="{DynamicResource DividerBrush}" />

                        <construction:Region
                            x:Name="PART_MainContentRegion"
                            Grid.Column="2"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{TemplateBinding MainContent}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
