<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Common page geometry -->

    <Thickness x:Key="PageMargin">28</Thickness>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PageScrollStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Thickness x:Key="PageFooterMargin">0,18,0,0</Thickness>


    <!-- Configuration-page geometry -->

    <GridLength x:Key="ConfigurationSelectorWidth">280</GridLength>
    <GridLength x:Key="ConfigurationColumnGap">18</GridLength>

    <Style
        x:Key="ConfigurationSelectorCardStyle"
        TargetType="Border"
        BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style
        x:Key="ConfigurationSelectorHeaderStyle"
        TargetType="Grid">
        <Setter Property="Margin" Value="16,14,12,10" />
    </Style>

    <Style
        x:Key="ConfigurationSelectorTitleStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource SectionTitleStyle}">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style
        x:Key="ConfigurationSelectorSeparatorStyle"
        TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style
        x:Key="ConfigurationPageFooterStyle"
        TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="{StaticResource PageFooterMargin}" />
    </Style>

</ResourceDictionary>