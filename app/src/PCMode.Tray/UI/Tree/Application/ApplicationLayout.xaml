<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:construction="clr-namespace:PCMode.Tray.UI.Framework"
                    xmlns:tree="clr-namespace:PCMode.Tray.UI.Tree">
    <!--
        WPF owns each native Window separately, so every surface instantiates
        this same root with exactly one populated region. The construction
        grammar stays shared even though the native visual roots cannot be
        parented to one another.
    -->
    <Style TargetType="{x:Type tree:ApplicationBlock}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tree:ApplicationBlock}">
                    <Grid>
                        <construction:Region x:Name="PART_MainWindowRegion"
                                             Content="{TemplateBinding MainWindow}"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Stretch" />

                        <construction:Region x:Name="PART_PickerRegion"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Stretch">
                            <construction:FinalUiComponent Content="{TemplateBinding Picker}"
                                                           HorizontalContentAlignment="Stretch"
                                                           VerticalContentAlignment="Stretch" />
                        </construction:Region>

                        <construction:Region x:Name="PART_SetupRegion"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Stretch">
                            <construction:FinalUiComponent Content="{TemplateBinding Setup}"
                                                           HorizontalContentAlignment="Stretch"
                                                           VerticalContentAlignment="Stretch" />
                        </construction:Region>

                        <construction:Region x:Name="PART_DialogRegion"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Stretch">
                            <construction:FinalUiComponent Content="{TemplateBinding Dialog}"
                                                           HorizontalContentAlignment="Stretch"
                                                           VerticalContentAlignment="Stretch" />
                        </construction:Region>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
