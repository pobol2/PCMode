<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:construction="clr-namespace:PCMode.Tray.UI.Framework">
    <!--
        The generic region mechanism. App.xaml merges this at application
        scope; nothing product-specific belongs here.
        
        Regions are placeholders, not components: their default appearance is
        a pure passthrough, so a region never contributes visuals of its own.
        A Layout needing a region to look like something (a border, padding,
        a scroll viewer) styles it there, inside that Layout, rather than
        changing what a region is everywhere.
    -->

    <Style TargetType="{x:Type construction:Region}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type construction:Region}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type construction:RepeatedRegion}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type construction:RepeatedRegion}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The explicit leaf of the semantic tree. Unlike a Region it owns no
        continuation contract; all ordinary WPF content inside it is opaque to
        the construction framework.
    -->
    <Style TargetType="{x:Type construction:FinalUiComponent}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type construction:FinalUiComponent}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
