<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:migration="clr-namespace:PCMode.Tray.UI.Components.Migration"
    xmlns:selection="clr-namespace:PCMode.Tray.UI.Components.Selection">

    <Style TargetType="{x:Type migration:MigrationContent}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type migration:MigrationContent}">
                    <!--
                        Source is rendered as its own opaque text, never through
                        implicit DataTemplate resolution: a ContentPresenter would
                        look up a template by Source's CLR type, and every Element
                        that hands MigrationContent its own instance as Source
                        (Home/Settings/Diagnostics via {Binding}; Applications/Rgb/
                        Spaces via `this`) would resolve straight back to the
                        DataTemplate that is already realizing this same page,
                        an infinite self-nesting that overflows the layout stack.
                        Source stays available to the future dedicated component,
                        per its own doc comment; nothing here may auto-template it.
                    -->
                    <Grid>
                        <TextBlock
                            x:Name="PART_Source"
                            Text="{Binding Source, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0}}"
                            Foreground="{DynamicResource MutedForegroundBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PART_Description"
                            Text="{TemplateBinding Description}"
                            Foreground="{DynamicResource MutedForegroundBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Source" Value="{x:Null}">
                            <Setter TargetName="PART_Source" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Description" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type selection:SelectorItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type selection:SelectorItem}">
                    <Button
                        HorizontalContentAlignment="Stretch"
                        Padding="12,9"
                        Command="{TemplateBinding Command}"
                        CommandParameter="{TemplateBinding CommandParameter}">
                        <StackPanel>
                            <TextBlock
                                Text="{TemplateBinding Title}"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="{TemplateBinding Summary}"
                                Foreground="{DynamicResource MutedForegroundBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

