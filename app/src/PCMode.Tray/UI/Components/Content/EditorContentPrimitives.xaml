<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:content="clr-namespace:PCMode.Tray.UI.Components.Content">
    <sys:Double x:Key="EditorBoxContentSpacing">12</sys:Double>
    <sys:Double x:Key="EditorBoxCollectionItemSpacing">10</sys:Double>
    <Thickness x:Key="EditorBoxInputPadding">0,2</Thickness>
    <Thickness x:Key="EditorBoxInputHintMargin">0,5,0,0</Thickness>
    <Thickness x:Key="EditorBoxInputTrailingMargin">12,0,0,0</Thickness>
    <Thickness x:Key="EditorBoxActionItemMargin">0,0,8,8</Thickness>

    <Style TargetType="{x:Type content:EditorBoxContent}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <content:VerticalSpacingPanel Spacing="{StaticResource EditorBoxContentSpacing}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="Visibility" Value="{Binding Content.Visibility, RelativeSource={RelativeSource Self}}" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type content:InformationContent}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type content:InformationContent}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LabelColumn" Width="{DynamicResource FieldLabelWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PART_Label"
                                   Text="{TemplateBinding Label}"
                                   Style="{StaticResource MutedTextStyle}"
                                   VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value="">
                            <Setter TargetName="LabelColumn" Property="Width" Value="0" />
                            <Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="LabelColumn" Property="Width" Value="0" />
                            <Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleFieldComboBoxStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style TargetType="{x:Type content:InputContent}">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{StaticResource EditorBoxInputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type content:InputContent}">
                    <Border Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LabelColumn" Width="{DynamicResource FieldLabelWidth}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PART_Label"
                                       Text="{TemplateBinding Label}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <TextBlock x:Name="PART_Hint"
                                           Text="{TemplateBinding Hint}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="{StaticResource EditorBoxInputHintMargin}" />
                            </StackPanel>
                            <ContentPresenter x:Name="PART_Trailing"
                                              Grid.Column="2"
                                              Content="{TemplateBinding Trailing}"
                                              Margin="{StaticResource EditorBoxInputTrailingMargin}"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Hint" Value="">
                            <Setter TargetName="PART_Hint" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Hint" Value="{x:Null}">
                            <Setter TargetName="PART_Hint" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Trailing" Value="{x:Null}">
                            <Setter TargetName="PART_Trailing" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Trailing" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsTitle" Value="True">
                            <Setter TargetName="LabelColumn" Property="Width" Value="0" />
                            <Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type content:ActionContent}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="{StaticResource EditorBoxActionItemMargin}" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type content:CollectionContent}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <content:VerticalSpacingPanel Spacing="{StaticResource EditorBoxCollectionItemSpacing}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type content:CustomContent}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type content:CustomContent}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
