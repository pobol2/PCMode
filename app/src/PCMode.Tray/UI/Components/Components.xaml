<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:inputs="clr-namespace:PCMode.Tray.UI.Components.Inputs"
                    xmlns:actions="clr-namespace:PCMode.Tray.UI.Components.Actions"
                    xmlns:selection="clr-namespace:PCMode.Tray.UI.Components.Selection"
                    xmlns:status="clr-namespace:PCMode.Tray.UI.Components.Status"
                    xmlns:visualizations="clr-namespace:PCMode.Tray.UI.Components.Visualizations">
    <Style TargetType="{x:Type selection:SelectorItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type selection:SelectorItem}">
                    <Border x:Name="Surface"
                            Margin="6,2"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Button x:Name="PART_SelectButton"
                                Padding="10,8"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{TemplateBinding Command}"
                                CommandParameter="{TemplateBinding CommandParameter}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center" />
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Title}"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{TemplateBinding Summary}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger SourceName="PART_SelectButton" Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            <Setter TargetName="Surface" Property="Opacity" Value="0.58" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type inputs:BrowseFileRow}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type inputs:BrowseFileRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{TemplateBinding ToolTipText}" />

                        <Button x:Name="PART_BrowseButton"
                                Grid.Column="1"
                                Content="Browse..."
                                Style="{StaticResource CompactSecondaryButtonStyle}"
                                Margin="8,0,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type inputs:UnitTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type inputs:UnitTextBox}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="64"
                                 TextAlignment="Right"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock x:Name="PART_Unit"
                                   Text="{TemplateBinding Unit}"
                                   Style="{StaticResource PageUnitSuffixTextStyle}"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Unit" Value="">
                            <Setter TargetName="PART_Unit" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Unit" Value="{x:Null}">
                            <Setter TargetName="PART_Unit" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type actions:RemovableRow}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type actions:RemovableRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        <Button x:Name="PART_RemoveButton"
                                Grid.Column="1"
                                Content="Remove"
                                Style="{StaticResource CompactSecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type status:StatusDot}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type status:StatusDot}">
                    <Ellipse x:Name="Dot" Fill="{DynamicResource MutedForegroundBrush}" />

                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="Success">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SuccessBrush}" />
                        </Trigger>

                        <Trigger Property="State" Value="Warning">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                        </Trigger>

                        <Trigger Property="State" Value="Error">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ErrorBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type visualizations:MonitorArrangementPad}">
        <Setter Property="Width" Value="900" />
        <Setter Property="Height" Value="440" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding PreviewLeft}" />
                    <Setter Property="Canvas.Top" Value="{Binding PreviewTop}" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type visualizations:MonitorArrangementPad}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type visualizations:CursorPositionPad}">
        <Setter Property="Width" Value="520" />
        <Setter Property="Height" Value="260" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type visualizations:CursorPositionPad}">
                    <Border Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Canvas x:Name="PART_Surface"
                                Background="Transparent"
                                ClipToBounds="True">
                            <Ellipse x:Name="PART_Marker"
                                     Width="18"
                                     Height="18"
                                     Fill="{DynamicResource AccentBrush}"
                                     Stroke="{DynamicResource AccentTextBrush}"
                                     StrokeThickness="2" />
                        </Canvas>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
