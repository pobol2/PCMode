<Window x:Class="PCMode.Tray.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCMode"
        Width="1100"
        Height="720"
        MinWidth="800"
        MinHeight="520"
        Style="{StaticResource MainWindowStyle}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="NavigationList"
                Grid.Column="0"
                Style="{StaticResource NavigationListStyle}"
                SelectionChanged="OnNavigationChanged">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Tag="{Binding IsExpanded}"
                                Style="{StaticResource ExpansionToggleButtonStyle}"
                                Click="OnExpanderClick"
                                Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibility}}" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Label}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin"
                                            Value="0" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChild}"
                                                    Value="True">
                                            <Setter Property="Margin"
                                                    Value="20,0,0,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <Border Grid.Column="1"
                Background="{DynamicResource DividerBrush}" />

        <ContentControl x:Name="PageHost"
                        Grid.Column="2" />
    </Grid>
</Window>
