<Window x:Class="PCMode.Tray.Setup.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCMode - Guided setup"
        Width="820" Height="640"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainWindowStyle}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StepTitle" Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />

        <Grid Grid.Row="1">
            <StackPanel x:Name="WelcomeContent" VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="PCMode switches this PC between the environments you configure -- displays, audio, cursor position and more -- with one click or hotkey."
                           TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Guided setup will not change anything on your PC. It only helps you record hardware aliases and at least one target. Nothing is applied until you explicitly switch to a target afterwards."
                           TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" />

            <StackPanel x:Name="FinishContent" VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="You can reopen Guided setup at any time; nothing here changed your hardware."
                           TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Content="Back" Style="{StaticResource SecondaryButtonStyle}" Click="OnBackClick" />
            <Button x:Name="SkipSetupButton" Grid.Column="2" Content="Skip Guided setup" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,12,0" Click="OnSkipSetupClick" />
            <Button x:Name="NextButton" Grid.Column="3" Content="Next" Style="{StaticResource PrimaryButtonStyle}" Click="OnNextClick" />
        </Grid>
    </Grid>
</Window>
