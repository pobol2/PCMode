<shells:ListPageShell
    x:Class="PCMode.Tray.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shells="clr-namespace:PCMode.Tray.Controls.PageShells"
    xmlns:components="clr-namespace:PCMode.Tray.Controls.Components"

    PageTitle="Settings"
    PageDescription="Configure PCMode itself. Editing these values never applies a target.">

    <shells:ListPageShell.FooterContent>
        <StackPanel>
            <TextBlock
                Text="{Binding StatusMessage}"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"
                TextWrapping="Wrap"
                Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button
                    Content="Discard changes"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    Click="OnDiscardClick" />
                <Button
                    Content="Save"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    IsEnabled="{Binding CanEdit}"
                    Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </shells:ListPageShell.FooterContent>

    <StackPanel>

        <components:PageSection Title="Appearance" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Theme" Margin="0,0,0,7" />
                <ComboBox
                    Width="220"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding ThemeOptions}"
                    DisplayMemberPath="Name"
                    SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource MutedForegroundBrush}"
                    TextWrapping="Wrap"
                    Text="Saved now; applied to PCMode's own windows once app chrome theming ships." />
            </StackPanel>
        </components:PageSection>

        <components:PageSection Title="Picker" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Open picker on" Margin="0,0,0,7" />
                <ComboBox
                    Width="320"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding MonitorOptions}"
                    DisplayMemberPath="Name"
                    SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource MutedForegroundBrush}"
                    TextWrapping="Wrap"
                    Text="Picker favorites and direct shortcuts are not yet editable here -- they carry over unchanged from what was last saved." />
            </StackPanel>
        </components:PageSection>

        <components:PageSection Title="Startup" Margin="0,0,0,16">
            <StackPanel>
                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                <CheckBox
                    Margin="20,8,0,0"
                    Content="Start minimized"
                    IsEnabled="{Binding StartWithWindows}"
                    IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" />
                <TextBlock
                    Margin="20,6,0,18"
                    Foreground="{DynamicResource MutedForegroundBrush}"
                    TextWrapping="Wrap"
                    Text="Registers PCMode for the current user without administrator access." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="On launch" VerticalAlignment="Center" />
                    <ComboBox
                        Grid.Column="1"
                        Width="280"
                        ItemsSource="{Binding LaunchBehaviorOptions}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedLaunchBehavior, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="Target" VerticalAlignment="Center" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,12,0,0"
                        Width="280"
                        ItemsSource="{Binding Targets}"
                        DisplayMemberPath="DisplayPath"
                        SelectedValuePath="Key"
                        SelectedValue="{Binding StartupTarget, Mode=TwoWay}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="IsEnabled" Value="{Binding Enabled}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </Grid>
                <TextBlock
                    Margin="0,10,0,0"
                    Foreground="{DynamicResource MutedForegroundBrush}"
                    TextWrapping="Wrap"
                    Text="Launch behavior takes effect the next time PCMode starts." />
            </StackPanel>
        </components:PageSection>

        <components:PageSection Title="Controller" Margin="0,0,0,16">
            <StackPanel>
                <CheckBox Content="Enable controller input" IsChecked="{Binding ControllerEnabled, Mode=TwoWay}" />
                <TextBlock
                    Margin="20,6,0,0"
                    Foreground="{DynamicResource MutedForegroundBrush}"
                    TextWrapping="Wrap"
                    Text="Supports Xbox-compatible controllers. Saving restarts the input host safely once one exists." />
            </StackPanel>
        </components:PageSection>

        <components:PageSection x:Name="GuidedSetupSection" Title="Guided setup">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Foreground="{DynamicResource MutedForegroundBrush}"
                    TextWrapping="Wrap"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Text="Run the guided setup again to review devices, spaces, and basic preferences." />
                <Button
                    Grid.Column="1"
                    Content="Guided setup"
                    Style="{StaticResource CompactSecondaryButtonStyle}"
                    Click="OnGuidedSetupClick" />
            </Grid>
        </components:PageSection>

    </StackPanel>

</shells:ListPageShell>
