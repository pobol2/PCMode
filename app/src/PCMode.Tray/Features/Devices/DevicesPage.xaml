<shells:ListPageShell
    x:Class="PCMode.Tray.Features.Devices.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shells="clr-namespace:PCMode.Tray.Controls.PageShells"
    xmlns:components="clr-namespace:PCMode.Tray.Controls.Components"

    PageTitle="Devices"
    PageDescription="What PCMode can currently see on this machine.">

    <shells:ListPageShell.HeaderActionContent>
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Text="{Binding StatusMessage}"
                Style="{StaticResource MutedTextStyle}"
                VerticalAlignment="Center"
                Margin="0,0,12,0" />
            <Button
                Content="Rescan"
                Click="OnRescanClick"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </shells:ListPageShell.HeaderActionContent>

    <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <components:PageSection Title="{Binding Category}" Margin="0,0,0,16">
                    <StackPanel>

                        <TextBlock
                            Text="{Binding Problem}"
                            Foreground="{DynamicResource ErrorBrush}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,4">
                                        <Expander.Header>
                                            <Grid Margin="4,4,8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <components:StatusDot
                                                    Grid.Column="0"
                                                    State="{Binding StatusState}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock
                                                        Text="{Binding Summary}"
                                                        Style="{StaticResource MutedTextStyle}" />
                                                </StackPanel>

                                                <Button
                                                    Grid.Column="2"
                                                    Content="{Binding AliasActionLabel}"
                                                    Click="OnAliasActionClick"
                                                    Style="{StaticResource CompactSecondaryButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding SupportsAlias, Converter={StaticResource BooleanToVisibility}}" />
                                            </Grid>
                                        </Expander.Header>

                                        <ItemsControl
                                            ItemsSource="{Binding Details}"
                                            Margin="24,4,4,8"
                                            Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Text="{Binding Label}"
                                                            Style="{StaticResource MutedTextStyle}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </components:PageSection>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</shells:ListPageShell>
