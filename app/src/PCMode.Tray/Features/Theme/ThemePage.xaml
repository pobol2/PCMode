<shells:ConfigurationPageShell
    x:Class="PCMode.Tray.Features.Theme.ThemePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shells="clr-namespace:PCMode.Tray.Controls.PageShells"
    xmlns:components="clr-namespace:PCMode.Tray.Controls.Components"

    PageTitle="Theme"
    PageDescription="Switch Windows between Light and Dark right now. This does not change what a Space requires -- set that on the Space itself."

    SelectorTitle="Windows theme"
    SelectorDescription="Which mode Windows is using right now"

    EditorEyebrow="WINDOWS THEME"
    EditorTitle="{Binding SelectedChoice, TargetNullValue=No theme selected}"

    ShowCreateButton="False"
    CanUseActions="False"
    ShowFooter="False"

    PrimaryActionLabel="Set now"
    CanUsePrimaryAction="{Binding CanApplySelected}"
    PrimaryActionRequested="OnApplyClick"

    SelectorItemsSource="{Binding Choices}">

    <shells:ConfigurationPageShell.SelectorItemTemplate>

        <DataTemplate>
            <components:ConfigurationSelectorItem
                Title="{Binding Name}"
                BadgeText="Current"
                IsBadgeVisible="{Binding IsCurrent}" />
        </DataTemplate>

    </shells:ConfigurationPageShell.SelectorItemTemplate>

    <shells:ConfigurationPageShell.EditorContent>

        <TextBlock
            Text="Choosing Light or Dark here changes the live Windows theme immediately, the same way Cursor's and Case lighting's Activate move the machine without saving anything."
            TextWrapping="Wrap"
            Style="{StaticResource MutedTextStyle}" />

    </shells:ConfigurationPageShell.EditorContent>

</shells:ConfigurationPageShell>
