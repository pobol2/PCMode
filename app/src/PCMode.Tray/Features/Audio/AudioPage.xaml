<shells:ConfigurationPageShell
    x:Class="PCMode.Tray.Features.Audio.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shells="clr-namespace:PCMode.Tray.Controls.PageShells"
    xmlns:components="clr-namespace:PCMode.Tray.Controls.Components"

    PageTitle="Audio output"
    PageDescription="Your outputs, and the Party group that plays through two of them at once. Changes here do not apply a mode."

    SelectorTitle="Audio"
    SelectorDescription="Configured audio resources"

    EditorEyebrow="AUDIO"
    EditorTitle="{Binding SelectedResource.Name, TargetNullValue=No audio resource selected}"

    ShowCreateButton="False"
    CanUseActions="False"

    PrimaryActionLabel="Activate"
    CanUsePrimaryAction="{Binding CanActivateSelected}"
    PrimaryActionRequested="OnActivateClick"

    ShowFooter="{Binding IsPartySelected}"

    SelectorItemsSource="{Binding Resources}">

    <shells:ConfigurationPageShell.SelectorItemTemplate>

        <DataTemplate>
            <components:ConfigurationSelectorItem
                Title="{Binding Name}"
                BadgeText="Current"
                IsBadgeVisible="{Binding IsCurrent}" />
        </DataTemplate>

    </shells:ConfigurationPageShell.SelectorItemTemplate>


    <shells:ConfigurationPageShell.EditorContent>
        <Grid>

            <StackPanel Visibility="{Binding IsOutputSelected, Converter={StaticResource BooleanToVisibility}}">

                <components:FieldRow
                    Label="Windows output"
                    Margin="0,14,0,0">

                    <TextBlock Text="{Binding SelectedOutput.EndpointName}" TextWrapping="Wrap" />

                </components:FieldRow>

                <components:FieldRow Label="Status">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource MutedForegroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOutput.IsReady}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedOutput.HasProblem}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock Text="{Binding SelectedOutput.StateText}" TextWrapping="Wrap" />

                    </StackPanel>

                </components:FieldRow>

                <components:FieldRow
                    Label="Party role"
                    Visibility="{Binding SelectedOutput.IsInParty, Converter={StaticResource BooleanToVisibility}}">

                    <TextBlock Text="{Binding SelectedOutput.PartyRole}" />

                </components:FieldRow>

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,16,0,0"
                    Visibility="{Binding SelectedResource.IsCurrent, Converter={StaticResource BooleanToVisibility}}">

                    <TextBlock
                        Text="Windows is playing through this output now."
                        Foreground="{DynamicResource SuccessBrush}"
                        TextWrapping="Wrap" />

                </Border>

                <TextBlock
                    Text="Output mappings are managed on the Devices page. Use Activate to switch Windows to this output."
                    Style="{StaticResource MutedTextStyle}"
                    Margin="0,16,0,0"
                    TextWrapping="Wrap" />

            </StackPanel>


            <StackPanel Visibility="{Binding IsPartySelected, Converter={StaticResource BooleanToVisibility}}">

                <TextBlock
                    Text="One sound source through two outputs at once. The reference is the slower path in the room -- usually the soundbar or TV -- and the other is delayed to meet it."
                    Style="{StaticResource MutedTextStyle}"
                    Margin="0,14,0,12"
                    TextWrapping="Wrap" />

                <CheckBox
                    Content="Configure a Party group"
                    IsChecked="{Binding PartyEnabled, Mode=TwoWay}"
                    Margin="0,0,0,14" />

                <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,14">

                    <StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource MutedForegroundBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPartyRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding PartyStateText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock
                            Text="{Binding PartyHealthText}"
                            Style="{StaticResource MutedTextStyle}"
                            Margin="0,6,0,0"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasPartyHealth, Converter={StaticResource BooleanToVisibility}}" />

                    </StackPanel>

                </Border>

                <StackPanel IsEnabled="{Binding PartyEnabled}">

                    <components:FieldRow Label="Name a mode asks for" Margin="0,0,0,10">
                        <TextBox
                            MaxWidth="280"
                            HorizontalAlignment="Left"
                            Text="{Binding PartyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </components:FieldRow>

                    <components:FieldRow
                        Label="Reference output"
                        Hint="Windows plays through this one, and the copy is captured from it."
                        Margin="0,0,0,10">

                        <ComboBox
                            MaxWidth="280"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding OutputChoices}"
                            SelectedItem="{Binding ReferenceOutput, Mode=TwoWay}" />

                    </components:FieldRow>

                    <components:FieldRow
                        Label="Mirrored output"
                        Hint="The copy. Only this one can be delayed."
                        Margin="0,0,0,16">

                        <ComboBox
                            MaxWidth="280"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding OutputChoices}"
                            SelectedItem="{Binding MirroredOutput, Mode=TwoWay}" />

                    </components:FieldRow>

                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,4">

                        <StackPanel>

                            <TextBlock Text="ALIGNMENT" Style="{StaticResource EyebrowTextStyle}" />

                            <TextBlock
                                Text="Delay and gain are saved with the group and take effect the next time it starts."
                                Margin="0,6,0,12"
                                TextWrapping="Wrap" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{DynamicResource FieldLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Mirrored delay" VerticalAlignment="Center" />

                                <Slider
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="2000"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    Margin="0,0,12,0"
                                    Value="{Binding DelayMs, Mode=TwoWay}" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="-10" Style="{StaticResource CompactSecondaryButtonStyle}" Margin="0,0,4,0" Tag="-10" Click="OnNudgeDelayClick" />
                                    <Button Content="-1" Style="{StaticResource CompactSecondaryButtonStyle}" Margin="0,0,4,0" Tag="-1" Click="OnNudgeDelayClick" />
                                    <TextBox Width="62" TextAlignment="Right" VerticalContentAlignment="Center" Text="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Text="ms" Style="{StaticResource PageUnitSuffixTextStyle}" Margin="5,0,6,0" />
                                    <Button Content="+1" Style="{StaticResource CompactSecondaryButtonStyle}" Margin="0,0,4,0" Tag="1" Click="OnNudgeDelayClick" />
                                    <Button Content="+10" Style="{StaticResource CompactSecondaryButtonStyle}" Tag="10" Click="OnNudgeDelayClick" />
                                </StackPanel>

                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{DynamicResource FieldLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Mirrored gain" VerticalAlignment="Center" />

                                <Slider
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="2"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="0.01"
                                    Margin="0,0,12,0"
                                    Value="{Binding Gain, Mode=TwoWay}" />

                                <TextBlock Grid.Column="2" Text="{Binding GainText}" VerticalAlignment="Center" MinWidth="46" TextAlignment="Right" />

                            </Grid>

                        </StackPanel>

                    </Border>

                    <Expander Margin="0,14,0,0" Padding="0,10,0,0">

                        <Expander.Header>
                            <TextBlock Text="Advanced" Style="{StaticResource ExpanderMinorHeaderStyle}" />
                        </Expander.Header>

                        <StackPanel>

                            <TextBlock
                                TextWrapping="Wrap"
                                Style="{StaticResource MutedTextStyle}"
                                Margin="0,0,0,12"
                                Text="Endpoint volumes are the sliders Windows itself shows for each device. PCMode sets them when the group starts; left off, each device keeps whatever level you last gave it." />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Content="Set the reference volume" VerticalAlignment="Center" IsChecked="{Binding UseReferenceVolume, Mode=TwoWay}" />

                                <Slider
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="0.01"
                                    Margin="0,0,12,0"
                                    IsEnabled="{Binding UseReferenceVolume}"
                                    Value="{Binding ReferenceVolume, Mode=TwoWay}" />

                                <TextBlock Grid.Column="2" Text="{Binding ReferenceVolumeText}" VerticalAlignment="Center" MinWidth="46" TextAlignment="Right" />

                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Content="Set the mirrored volume" VerticalAlignment="Center" IsChecked="{Binding UseMirroredVolume, Mode=TwoWay}" />

                                <Slider
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="0.01"
                                    Margin="0,0,12,0"
                                    IsEnabled="{Binding UseMirroredVolume}"
                                    Value="{Binding MirroredVolume, Mode=TwoWay}" />

                                <TextBlock Grid.Column="2" Text="{Binding MirroredVolumeText}" VerticalAlignment="Center" MinWidth="46" TextAlignment="Right" />

                            </Grid>

                            <TextBlock
                                TextWrapping="Wrap"
                                Style="{StaticResource MutedTextStyle}"
                                Margin="0,14,0,0"
                                Text="This first version is two shared-mode outputs on this PC: no Bluetooth synchronisation guarantee, no exclusive-mode or protected playback, no per-application routing." />

                        </StackPanel>

                    </Expander>

                </StackPanel>

            </StackPanel>

        </Grid>
    </shells:ConfigurationPageShell.EditorContent>

</shells:ConfigurationPageShell>
