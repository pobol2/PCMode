<Window x:Class="PCMode.Tray.Features.Spaces.TargetReferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCMode"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <!-- Shown only when deleting something whose targets are still a picker
         favorite or the startup target: every affected reference needs an
         explicit replacement, chosen here, before the delete may proceed. -->

    <StackPanel Margin="22">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,14" />

        <ItemsControl x:Name="FavoritesList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}"
                                  DisplayMemberPath="DisplayPath" SelectedValuePath="Key"
                                  SelectedValue="{Binding Selected, Mode=TwoWay}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid x:Name="StartupRow" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Startup target" VerticalAlignment="Center" />
            <ComboBox x:Name="StartupBox" Grid.Column="1" />
        </Grid>

        <TextBlock x:Name="ErrorText"
                   Foreground="{DynamicResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button Content="Continue"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    Click="OnContinueClick" />
        </StackPanel>
    </StackPanel>
</Window>
