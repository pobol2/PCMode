<Window x:Class="PCMode.Tray.Features.Spaces.NewSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New source"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <!-- A source needs a kind as well as a name, because not every source is a
         program on this PC: a console on an HDMI input and an app on the
         television are sources too. -->

    <StackPanel Margin="22">

        <TextBlock Text="Name the source and say what kind of thing it is. It starts with everything inherited from its activity."
                   Style="{StaticResource MutedTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Margin="0,0,0,14" KeyDown="OnKeyDown" />

        <TextBlock Text="Kind" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="KindBox" DisplayMemberPath="Label" SelectedValuePath="Kind" />

        <TextBlock x:Name="ErrorText"
                   Foreground="{DynamicResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button Content="Create"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    Click="OnCreateClick" />
        </StackPanel>

    </StackPanel>

</Window>
