<shells:ConfigurationPageShell
    x:Class="PCMode.Tray.Features.Spaces.SpacesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shells="clr-namespace:PCMode.Tray.Controls.PageShells"
    xmlns:components="clr-namespace:PCMode.Tray.Controls.Components"

    PageTitle="Spaces, activities and sources"
    PageDescription="Organize where the PC is used, what you do there, and which source provides it. Settings flow from Space to Activity to Source."

    SelectorTitle="Hierarchy"
    SelectorDescription="Space › Activity › Source"

    CreateRequested="OnCreateClick"

    CanUseActions="{Binding CanManage}"

    PrimaryActionLabel="Activate"
    CanUsePrimaryAction="{Binding CanActivateSelected}"
    PrimaryActionRequested="OnActivateClick"

    SelectorItemsSource="{Binding VisibleNodes}">

    <shells:ConfigurationPageShell.Resources>

        <ContextMenu x:Key="CreateMenu" Style="{StaticResource EditorContextMenuStyle}">

            <MenuItem Header="Space"
                      Style="{StaticResource EditorMenuItemStyle}"
                      Click="OnNewSpaceClick" />

            <MenuItem Header="{Binding AddActivityLabel}"
                      IsEnabled="{Binding CanAddActivity}"
                      Style="{StaticResource EditorMenuItemStyle}"
                      Click="OnNewActivityClick" />

            <MenuItem Header="{Binding AddSourceLabel}"
                      IsEnabled="{Binding CanAddSource}"
                      Style="{StaticResource EditorMenuItemStyle}"
                      Click="OnNewSourceClick" />

        </ContextMenu>

    </shells:ConfigurationPageShell.Resources>


    <shells:ConfigurationPageShell.SelectorItemTemplate>

        <DataTemplate>
            <Grid Margin="{Binding Indent, Converter={StaticResource IndentMargin}}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Tag="{Binding IsExpanded}"
                        Style="{StaticResource ExpansionToggleButtonStyle}"
                        Click="OnToggleExpandClick"
                        Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibility}}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text=" · Disabled"
                                   Style="{StaticResource MutedTextStyle}"
                                   Visibility="{Binding ShowsDisabled, Converter={StaticResource BooleanToVisibility}}" />

                        <Border Padding="6,1"
                                CornerRadius="7"
                                Margin="6,0,0,0"
                                Background="{DynamicResource AccentBrush}"
                                Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="Current"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                        </Border>

                        <Border Padding="6,1"
                                CornerRadius="7"
                                Margin="6,0,0,0"
                                Background="{DynamicResource AccentBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasCurrentDescendant}" Value="True" />
                                                <Condition Binding="{Binding IsExpanded}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Current inside"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                        </Border>

                    </StackPanel>

                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="11"
                               Margin="0,1,0,0" />

                </StackPanel>

            </Grid>
        </DataTemplate>

    </shells:ConfigurationPageShell.SelectorItemTemplate>


    <shells:ConfigurationPageShell.ActionsMenu>

        <ContextMenu Style="{StaticResource EditorContextMenuStyle}">

            <MenuItem Header="Rename"
                      Style="{StaticResource EditorMenuItemStyle}"
                      Click="OnRenameClick" />

            <MenuItem Header="{Binding DuplicateLabel}"
                      IsEnabled="{Binding CanDuplicate}"
                      Style="{StaticResource EditorMenuItemStyle}"
                      Click="OnDuplicateClick" />

            <MenuItem Header="Delete"
                      Style="{StaticResource EditorMenuItemStyle}"
                      Click="OnDeleteClick" />

        </ContextMenu>

    </shells:ConfigurationPageShell.ActionsMenu>


    <shells:ConfigurationPageShell.EditorContent>
        <StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">

                <CheckBox Content="Enabled"
                          IsChecked="{Binding Selected.TargetEnabled, Mode=OneWay}"
                          Visibility="{Binding Selected.IsActivatable, Converter={StaticResource BooleanToVisibility}}"
                          ToolTip="Disabled targets stay configured but cannot be switched to"
                          Click="OnEnabledClick" />

            </StackPanel>

            <TextBlock Text="Settings this level controls"
                       Style="{StaticResource SectionTitleStyle}" />

            <TextBlock Text="These flow down to every activity and source beneath it."
                       Style="{StaticResource MutedTextStyle}"
                       Margin="0,-4,0,10" />

            <TextBlock Text="This level does not control any settings of its own yet."
                       Style="{StaticResource MutedTextStyle}"
                       Margin="0,0,0,10"
                       Visibility="{Binding HasConfiguredSettings, Converter={StaticResource InverseBoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding ConfiguredSettings}" HorizontalContentAlignment="Stretch">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,10,0,11">

                            <StackPanel>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding StateSummary}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <ComboBox Grid.Column="1"
                                              MaxWidth="280"
                                              HorizontalAlignment="Left"
                                              IsEditable="True"
                                              ItemsSource="{Binding Choices}"
                                              Text="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button Grid.Column="2"
                                            Content="Remove"
                                            Style="{StaticResource CompactSecondaryButtonStyle}"
                                            Click="OnRemoveSettingClick" />

                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="160,6,0,0">

                                    <CheckBox Content="Best effort"
                                              Margin="0,0,16,0"
                                              IsChecked="{Binding UseBestEffort, Mode=TwoWay}" />

                                    <Button Content="Leave uncontrolled here"
                                            Style="{StaticResource CompactSecondaryButtonStyle}"
                                            Visibility="{Binding HasInheritedMessage, Converter={StaticResource BooleanToVisibility}}"
                                            Click="OnExcludeSettingClick" />

                                </StackPanel>

                                <TextBlock Text="{Binding AvailabilityMessage}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="160,4,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasAvailabilityMessage, Converter={StaticResource BooleanToVisibility}}" />

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <TextBlock Text="Not yet controlled here"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,20,0,0"
                       Visibility="{Binding HasAddableSettings, Converter={StaticResource BooleanToVisibility}}" />

            <ItemsControl ItemsSource="{Binding AddableSettings}"
                          Margin="0,8,0,0"
                          HorizontalContentAlignment="Stretch">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    Content="Add"
                                    Style="{StaticResource CompactSecondaryButtonStyle}"
                                    Click="OnAddSettingClick" />

                        </Grid>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>
    </shells:ConfigurationPageShell.EditorContent>


    <shells:ConfigurationPageShell.SecondaryEditorContent>

      <StackPanel>

        <Border Style="{StaticResource CardStyle}"
                Visibility="{Binding HasInheritedSettings, Converter={StaticResource BooleanToVisibility}}">

            <Expander IsExpanded="False">

                <Expander.Header>
                    <TextBlock Text="Inherited from parent" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                </Expander.Header>

                <StackPanel Margin="0,12,0,0">

                    <TextBlock Text="These already apply to this target. Override only what should be different here."
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,-4,0,10"
                               TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding InheritedSettings}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Grid Margin="0,0,0,10">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding InheritedMessage}"
                                               Style="{StaticResource MutedTextStyle}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />

                                    <Button Grid.Column="2"
                                            Content="Override here"
                                            Style="{StaticResource CompactSecondaryButtonStyle}"
                                            Click="OnOverrideSettingClick" />

                                </Grid>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Expander>

        </Border>

        <Border Style="{StaticResource CardStyle}"
                Margin="0,14,0,0"
                Visibility="{Binding ShowsPickerConfiguration, Converter={StaticResource BooleanToVisibility}}">

            <Expander IsExpanded="False">

                <Expander.Header>
                    <TextBlock Text="Quick access" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                </Expander.Header>

                <StackPanel Margin="0,12,0,0">

                    <TextBlock Text="Optionally put this target on the four-way picker, give it a direct shortcut, or use both."
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,-4,0,10"
                               TextWrapping="Wrap" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Picker position" VerticalAlignment="Center" />

                        <ComboBox Grid.Column="1"
                                  MaxWidth="280"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding PickerPositionOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedPickerPosition, Mode=TwoWay}" />

                        <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="Direct shortcuts" VerticalAlignment="Center" />

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">

                            <TextBox MaxWidth="220" MaxLength="52"
                                     Text="{Binding DirectShortcutKeys, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Ctrl+Alt plus each letter; separate multiple letters with commas" />

                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Ctrl+Alt + letter" />

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Expander>

        </Border>

      </StackPanel>

    </shells:ConfigurationPageShell.SecondaryEditorContent>

</shells:ConfigurationPageShell>
