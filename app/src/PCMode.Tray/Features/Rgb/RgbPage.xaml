<shells:ConfigurationPageShell
    x:Class="PCMode.Tray.Features.Rgb.RgbPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shells="clr-namespace:PCMode.Tray.Controls.PageShells"
    xmlns:components="clr-namespace:PCMode.Tray.Controls.Components"

    PageTitle="Case lighting"
    PageDescription="Named lighting profiles applied through OpenRGB. Each controller uses one colour and mode."

    HeaderSummaryText="{Binding SceneCountText}"

    SelectorTitle="Profiles"
    SelectorDescription="Configured lighting profiles"

    EditorEyebrow="LIGHTING PROFILE"
    EditorTitle="{Binding SelectedScene.Name, TargetNullValue=No profile selected}"

    CreateRequested="OnNewSceneClick"

    CanUseActions="{Binding HasSelectedScene}"

    PrimaryActionLabel="Activate"
    CanUsePrimaryAction="{Binding CanActivate}"
    PrimaryActionRequested="OnActivateClick"

    SelectorItemsSource="{Binding Scenes}">

    <shells:ConfigurationPageShell.SelectorItemTemplate>

        <DataTemplate>
            <components:ConfigurationSelectorItem
                Title="{Binding Name}"
                BadgeText="Current"
                IsBadgeVisible="{Binding IsActive}" />
        </DataTemplate>

    </shells:ConfigurationPageShell.SelectorItemTemplate>


    <shells:ConfigurationPageShell.ActionsMenu>

        <ContextMenu Style="{StaticResource EditorContextMenuStyle}">

            <MenuItem
                Header="Rename"
                Style="{StaticResource EditorMenuItemStyle}"
                Click="OnRenameClick" />

            <MenuItem
                Header="Delete"
                Style="{StaticResource EditorMenuItemStyle}"
                Click="OnDeleteClick" />

        </ContextMenu>

    </shells:ConfigurationPageShell.ActionsMenu>


    <shells:ConfigurationPageShell.EditorContent>
        <StackPanel>

            <TextBlock Text="Controllers"
                       Style="{StaticResource PageSubsectionTitleStyle}" />
            <TextBlock Text="Choose each controller's colour and OpenRGB mode."
                       Style="{StaticResource PageSubsectionDescriptionStyle}" />

            <ItemsControl ItemsSource="{Binding SelectedScene.Devices}"
                          Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding ControllerName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StateText}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding StateDetail}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Mode"
                                               VerticalAlignment="Center" />

                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Modes}"
                                              SelectedItem="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="False"
                                              VerticalContentAlignment="Center"
                                              ToolTip="OpenRGB mode for this controller" />

                                    <TextBlock Grid.Column="3"
                                               Text="Colour"
                                               VerticalAlignment="Center" />

                                    <TextBox Grid.Column="4"
                                             Text="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             MaxLength="6"
                                             IsEnabled="{Binding UsePerLed, Converter={StaticResource InverseBool}}"
                                             ToolTip="Six hexadecimal digits: RRGGBB" />

                                    <Border Grid.Column="5"
                                            Width="26"
                                            Height="26"
                                            Margin="8,0,0,0"
                                            CornerRadius="4"
                                            Background="{Binding ColorBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding HasLeds, Converter={StaticResource BooleanToVisibility}}">

                                    <CheckBox Content="Control LEDs individually"
                                              IsChecked="{Binding UsePerLed, Mode=TwoWay}"
                                              IsEnabled="{Binding CanConfigurePerLed}"
                                              ToolTip="{Binding PerLedHint}" />

                                    <ItemsControl ItemsSource="{Binding Leds}"
                                                  Margin="0,8,0,0"
                                                  Visibility="{Binding UsePerLed, Converter={StaticResource BooleanToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,10,6">
                                                    <TextBlock Text="{Binding Name}"
                                                               Width="70"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               ToolTip="{Binding Name}" />
                                                    <TextBox Text="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="70"
                                                             MaxLength="6"
                                                             VerticalContentAlignment="Center"
                                                             ToolTip="Six hexadecimal digits: RRGGBB" />
                                                    <Border Width="20"
                                                            Height="20"
                                                            Margin="6,0,0,0"
                                                            CornerRadius="4"
                                                            Background="{Binding ColorBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </shells:ConfigurationPageShell.EditorContent>


    <shells:ConfigurationPageShell.SecondaryEditorContent>

        <Border Style="{StaticResource CardStyle}">

            <Expander IsExpanded="False">

                <Expander.Header>
                    <TextBlock Text="Advanced"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0" />
                </Expander.Header>

                <StackPanel Margin="0,12,0,0">

                    <components:FieldRow
                        Label="SDK timeout"
                        Margin="0,0,0,10">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">

                            <TextBox Width="70"
                                     Text="{Binding WithinMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="ms"
                                       Style="{StaticResource PageUnitSuffixTextStyle}" />

                        </StackPanel>

                    </components:FieldRow>

                    <TextBlock Text="{Binding CurrentLightingText}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock
                        Text="PCMode connects to the external OpenRGB SDK server. Controller identities stay managed by the engine and are not shown here."
                        Style="{StaticResource MutedTextStyle}"
                        FontSize="11"
                        Margin="0,12,0,0"
                        TextWrapping="Wrap" />

                </StackPanel>

            </Expander>

        </Border>

    </shells:ConfigurationPageShell.SecondaryEditorContent>

</shells:ConfigurationPageShell>
