<shells:ConfigurationPageShell
    x:Class="PCMode.Tray.Features.Applications.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shells="clr-namespace:PCMode.Tray.Controls.PageShells"
    xmlns:components="clr-namespace:PCMode.Tray.Controls.Components"

    PageTitle="Applications"
    PageDescription="Define what PCMode can launch and, when useful, monitor."

    SelectorTitle="Applications"
    SelectorDescription="Configured applications"

    EditorEyebrow="APPLICATION"
    EditorTitle="{Binding SelectedApplication, TargetNullValue=No application selected}"

    CreateRequested="OnNewApplicationClick"

    CanUseActions="{Binding HasSelectedApplication}"

    PrimaryActionLabel="{Binding ActivateActionLabel}"
    CanUsePrimaryAction="{Binding CanActivate}"
    PrimaryActionRequested="OnActivateClick"

    SelectorItemsSource="{Binding ApplicationItems}">

    <shells:ConfigurationPageShell.SelectorItemTemplate>

        <DataTemplate>
            <components:ConfigurationSelectorItem
                Title="{Binding Name}"
                BadgeText="Running"
                IsBadgeVisible="{Binding IsRunning}" />
        </DataTemplate>

    </shells:ConfigurationPageShell.SelectorItemTemplate>
    

    <shells:ConfigurationPageShell.ActionsMenu>

        <ContextMenu Style="{StaticResource EditorContextMenuStyle}">

            <MenuItem
                Header="Rename"
                Style="{StaticResource EditorMenuItemStyle}"
                Click="OnRenameClick" />

            <MenuItem
                Header="Duplicate"
                Style="{StaticResource EditorMenuItemStyle}"
                Click="OnDuplicateClick" />

            <MenuItem
                Header="Delete"
                Style="{StaticResource EditorMenuItemStyle}"
                Click="OnDeleteClick" />

        </ContextMenu>

    </shells:ConfigurationPageShell.ActionsMenu>


    <shells:ConfigurationPageShell.EditorContent>
        <StackPanel>

            <TextBlock Text="Launch"
                    Style="{StaticResource PageSubsectionTitleStyle}" />

            <StackPanel Style="{StaticResource PageBinaryChoiceRowStyle}"
                        Margin="0,0,0,10">

                <RadioButton Content="Program"
                            GroupName="StartKind"
                            IsChecked="{Binding IsStartUri,
                                                Converter={StaticResource InverseBool},
                                                Mode=TwoWay}"
                            Margin="0,0,16,0" />

                <RadioButton Content="URI"
                            GroupName="StartKind"
                            IsChecked="{Binding IsStartUri,
                                                Mode=TwoWay}" />

            </StackPanel>

            <components:BrowseFileRow
                Margin="0,0,0,10"
                Visibility="{Binding IsStartUri,
                                    Converter={StaticResource InverseBoolToVisibility}}"
                Text="{Binding StartPath,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"
                Tag="Start"
                BrowseClick="OnBrowseClick" />

            <TextBox
                Margin="0,0,0,10"
                Visibility="{Binding IsStartUri,
                                    Converter={StaticResource BooleanToVisibility}}"
                Text="{Binding StartUri,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"
                ToolTip="For example steam://open/bigpicture or https://example.com" />

            <Expander
                Visibility="{Binding IsStartUri,
                                    Converter={StaticResource InverseBoolToVisibility}}"
                IsExpanded="False"
                Margin="0,2,0,0">

                <Expander.Header>
                    <TextBlock Text="Arguments"
                            Style="{StaticResource ExpanderMinorHeaderStyle}" />
                </Expander.Header>

                <TextBox
                    AcceptsReturn="True"
                    MinLines="2"
                    MaxLines="4"
                    Margin="0,8,0,0"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto"
                    Text="{Binding StartArgumentsText,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}" />

            </Expander>

            <TextBlock
                Text="{Binding AvailabilityMessage}"
                Foreground="{DynamicResource WarningBrush}"
                Margin="0,12,0,0"
                TextWrapping="Wrap"
                Visibility="{Binding HasAvailabilityMessage,
                                    Converter={StaticResource BooleanToVisibility}}" />

        </StackPanel>
    </shells:ConfigurationPageShell.EditorContent>


    <shells:ConfigurationPageShell.SecondaryEditorContent>

        <Border Style="{StaticResource CardStyle}">

            <Expander IsExpanded="False">

                <Expander.Header>

                    <TextBlock Text="Advanced"
                                Style="{StaticResource SectionTitleStyle}"
                                Margin="0" />

                </Expander.Header>


                <StackPanel Margin="0,14,0,0">


                    <!-- Runtime monitoring -->

                    <TextBlock Text="Runtime monitoring"
                                Style="{StaticResource PageSubsectionTitleStyle}" />

                    <CheckBox Content="Monitor a running process"
                                IsChecked="{Binding IsLaunchOnly,
                                                    Converter={StaticResource InverseBool},
                                                    Mode=TwoWay}"
                                Margin="0,0,0,10" />

                    <components:FieldRow
                        Label="Process name"
                        Hint="Enables running-state verification and Stop."
                        Visibility="{Binding IsLaunchOnly,
                                                Converter={StaticResource InverseBoolToVisibility}}">

                        <TextBox Text="{Binding ProcessName,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                    MaxWidth="280"
                                    HorizontalAlignment="Left"
                                    ToolTip="Without .exe" />

                    </components:FieldRow>


                    <TextBlock
                        Text="Without process monitoring, PCMode launches the target without claiming it is running."
                        Style="{StaticResource MutedTextStyle}"
                        Margin="0,8,0,0"
                        TextWrapping="Wrap"
                        Visibility="{Binding IsLaunchOnly,
                                                Converter={StaticResource BooleanToVisibility}}" />


                    <Border Style="{StaticResource PageInlineDividerStyle}" />


                    <!-- Dependencies -->

                    <TextBlock Text="Dependencies"
                                Style="{StaticResource PageSubsectionTitleStyle}" />

                    <TextBlock
                        Text="Optional resource values that must settle before launch."
                        Style="{StaticResource PageSubsectionDescriptionStyle}" />


                    <ItemsControl ItemsSource="{Binding Requires}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <components:RemovableRow
                                    Margin="0,0,0,8"
                                    RemoveClick="OnRemoveRequirementClick">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            Text="{Binding ResourceKey,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,0,8,0"
                                            ToolTip="Resource key" />

                                        <TextBox
                                            Grid.Column="1"
                                            Text="{Binding Value,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Required value" />

                                    </Grid>

                                </components:RemovableRow>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>


                    <Button Content="Add dependency"
                            Style="{StaticResource PageAddRowButtonStyle}"
                            Click="OnAddRequirementClick" />


                    <!-- Process behavior -->

                    <StackPanel
                        Visibility="{Binding IsLaunchOnly,
                                                Converter={StaticResource InverseBoolToVisibility}}">

                        <Border Style="{StaticResource PageInlineDividerStyle}" />

                        <TextBlock Text="Process behavior"
                                    Style="{StaticResource PageSubsectionTitleStyle}" />

                        <CheckBox Content="Use a custom Stop command"
                                    IsChecked="{Binding HasStop, Mode=TwoWay}"
                                    Margin="0,0,0,10" />


                        <StackPanel IsEnabled="{Binding HasStop}"
                                    Margin="0,0,0,12">

                            <StackPanel
                                Style="{StaticResource PageBinaryChoiceRowStyle}"
                                Margin="0,0,0,8">

                                <RadioButton
                                    Content="Program"
                                    GroupName="StopKind"
                                    IsChecked="{Binding IsStopUri,
                                                        Converter={StaticResource InverseBool},
                                                        Mode=TwoWay}"
                                    Margin="0,0,16,0" />

                                <RadioButton
                                    Content="URI"
                                    GroupName="StopKind"
                                    IsChecked="{Binding IsStopUri,
                                                        Mode=TwoWay}" />

                            </StackPanel>


                            <components:BrowseFileRow
                                Margin="0,0,0,8"
                                Visibility="{Binding IsStopUri,
                                                        Converter={StaticResource InverseBoolToVisibility}}"
                                Text="{Binding StopPath,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                Tag="Stop"
                                BrowseClick="OnBrowseClick" />


                            <TextBox
                                Margin="0,0,0,8"
                                Visibility="{Binding IsStopUri,
                                                        Converter={StaticResource BooleanToVisibility}}"
                                Text="{Binding StopUri,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="For example steam://exit" />


                            <Expander
                                Visibility="{Binding IsStopUri,
                                                        Converter={StaticResource InverseBoolToVisibility}}"
                                IsExpanded="False">

                                <Expander.Header>
                                    <TextBlock
                                        Text="Stop arguments"
                                        Style="{StaticResource ExpanderMinorHeaderStyle}" />
                                </Expander.Header>

                                <TextBox
                                    AcceptsReturn="True"
                                    MinLines="2"
                                    MaxLines="4"
                                    Margin="0,8,0,0"
                                    TextWrapping="NoWrap"
                                    VerticalScrollBarVisibility="Auto"
                                    Text="{Binding StopArgumentsText,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}" />

                            </Expander>

                        </StackPanel>


                        <CheckBox
                            Content="Re-issue Launch when already running"
                            IsChecked="{Binding Reactivate, Mode=TwoWay}"
                            Margin="0,0,0,12" />


                        <components:FieldRow
                            Label="Restart when"
                            Margin="0,0,0,12">

                            <TextBox
                                Text="{Binding RestartWhenText,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Comma-separated resource keys" />

                        </components:FieldRow>


                        <CheckBox
                            Content="Run an action when a window appears"
                            IsChecked="{Binding ReadyEnabled, Mode=TwoWay}"
                            Margin="0,0,0,10" />


                        <StackPanel IsEnabled="{Binding ReadyEnabled}"
                                    Margin="20,0,0,0">

                            <components:FieldRow
                                Label="Keys to type"
                                Margin="0,0,0,10">

                                <TextBox
                                    Text="{Binding ReadyKeys,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}" />

                            </components:FieldRow>


                            <components:FieldRow Label="Window timeout">

                                <StackPanel
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">

                                    <TextBox
                                        Width="70"
                                        Text="{Binding ReadyWithinMs,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Text="ms"
                                        Style="{StaticResource PageUnitSuffixTextStyle}" />

                                </StackPanel>

                            </components:FieldRow>

                        </StackPanel>

                    </StackPanel>


                    <Border Style="{StaticResource PageInlineDividerStyle}" />


                    <!-- Timeouts -->

                    <TextBlock Text="Timeouts"
                                Style="{StaticResource PageSubsectionTitleStyle}" />


                    <components:FieldRow
                        Label="Launch attempt"
                        Margin="0,0,0,10">

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">

                            <TextBox
                                Width="70"
                                Text="{Binding StartWithinMs,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Text="ms"
                                Style="{StaticResource PageUnitSuffixTextStyle}" />

                        </StackPanel>

                    </components:FieldRow>


                    <components:FieldRow
                        Label="Stop attempt"
                        Visibility="{Binding IsLaunchOnly,
                                                Converter={StaticResource InverseBoolToVisibility}}">

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">

                            <TextBox
                                Width="70"
                                Text="{Binding StopWithinMs,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Text="ms"
                                Style="{StaticResource PageUnitSuffixTextStyle}" />

                        </StackPanel>

                    </components:FieldRow>


                </StackPanel>

            </Expander>

        </Border>

    </shells:ConfigurationPageShell.SecondaryEditorContent>

</shells:ConfigurationPageShell>