<Window x:Class="PCMode.Tray.Features.Applications.NewApplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New application"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <StackPanel Margin="22">
        <TextBlock Text="Give the application a name and how PCMode should launch it."
                   Style="{StaticResource MutedTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Margin="0,0,0,14" />

        <TextBlock Text="Launch" FontWeight="SemiBold" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="ProgramOption"
                         Content="Program"
                         GroupName="StartKind"
                         IsChecked="True"
                         Margin="0,0,16,0"
                         Checked="OnStartKindChanged" />
            <RadioButton x:Name="UriOption"
                         Content="URI"
                         GroupName="StartKind"
                         Checked="OnStartKindChanged" />
        </StackPanel>

        <Grid x:Name="ProgramRow" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" />
            <Button Grid.Column="1"
                    Content="Browse..."
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="8,0,0,0"
                    Click="OnBrowseClick" />
        </Grid>

        <TextBox x:Name="UriBox"
                 Margin="0,0,0,14"
                 Visibility="Collapsed"
                 ToolTip="For example steam://open/bigpicture or https://example.com" />

        <Expander x:Name="AdvancedExpander" IsExpanded="False" Margin="0,0,0,14">
            <Expander.Header>
                <TextBlock Text="Advanced" FontWeight="SemiBold" />
            </Expander.Header>
            <StackPanel Margin="0,10,0,0">
                <CheckBox x:Name="MonitorProcessOption"
                          Content="Monitor a running process"
                          Margin="0,0,0,8"
                          Checked="OnProcessMonitoringChanged"
                          Unchecked="OnProcessMonitoringChanged" />

                <Grid x:Name="ProcessRow" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Process name"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,0,0,4" />
                    <TextBox x:Name="ProcessBox"
                             Grid.Row="1"
                             ToolTip="Without .exe" />
                </Grid>

                <TextBlock Text="When enabled, PCMode can verify whether the application is running and stop it."
                           Style="{StaticResource MutedTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Expander>

        <TextBlock x:Name="ErrorText"
                   Foreground="{DynamicResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    Click="OnCancelClick"
                    IsCancel="True" />
            <Button Content="Create"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnCreateClick"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
