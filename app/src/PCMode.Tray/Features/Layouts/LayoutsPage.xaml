<shells:ConfigurationPageShell
    x:Class="PCMode.Tray.Features.Layouts.LayoutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shells="clr-namespace:PCMode.Tray.Controls.PageShells"
    xmlns:components="clr-namespace:PCMode.Tray.Controls.Components"

    PageTitle="Display layouts"
    PageDescription="Arrange the monitors Windows should enable for this layout. Changes here do not switch displays."

    HeaderSummaryText="{Binding LayoutItems.Count, StringFormat={}{0} display layout(s)}"

    SelectorTitle="Layouts"
    SelectorDescription="Configured display layouts"

    EditorEyebrow="DISPLAY LAYOUT"
    EditorTitle="{Binding EditingLayoutName, TargetNullValue=No layout selected}"

    CreateRequested="OnNewLayoutClick"

    CanUseActions="{Binding HasSelectedLayout}"

    PrimaryActionLabel="Activate"
    CanUsePrimaryAction="{Binding CanActivateSelected}"
    PrimaryActionRequested="OnActivateClick"

    SelectorItemsSource="{Binding LayoutItems}">

    <shells:ConfigurationPageShell.Resources>
        <Style x:Key="MonitorPreviewButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MonitorSurface" CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Included}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter TargetName="MonitorSurface" Property="Opacity" Value="0.74" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Primary}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="3" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="4" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                    <Condition Binding="{Binding Included}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </MultiDataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MonitorSurface" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </shells:ConfigurationPageShell.Resources>

    <shells:ConfigurationPageShell.SelectorItemTemplate>
        <DataTemplate>
            <components:ConfigurationSelectorItem
                Title="{Binding Name}"
                BadgeText="Current"
                IsBadgeVisible="{Binding IsCurrent}" />
        </DataTemplate>
    </shells:ConfigurationPageShell.SelectorItemTemplate>

    <shells:ConfigurationPageShell.ActionsMenu>
        <ContextMenu Style="{StaticResource EditorContextMenuStyle}">
            <MenuItem Header="Rename" Style="{StaticResource EditorMenuItemStyle}" Click="OnRenameClick" />
            <MenuItem Header="Duplicate" Style="{StaticResource EditorMenuItemStyle}" Click="OnDuplicateClick" />
            <MenuItem Header="Delete" Style="{StaticResource EditorMenuItemStyle}" Click="OnDeleteClick" />
        </ContextMenu>
    </shells:ConfigurationPageShell.ActionsMenu>

    <shells:ConfigurationPageShell.EditorContent>
        <StackPanel>
            <TextBlock
                Text="{Binding InstructionMessage}"
                Foreground="{DynamicResource MutedForegroundBrush}"
                TextWrapping="Wrap"
                Margin="0,0,0,10"
                Visibility="{Binding InstructionMessage, Converter={StaticResource StringToVisibility}}" />

            <TextBlock Text="Monitor arrangement" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock
                Text="Select a monitor to edit it, or drag an enabled monitor beside another. Drops snap left, right, above, or below."
                Foreground="{DynamicResource MutedForegroundBrush}"
                Margin="0,-4,0,12"
                TextWrapping="Wrap" />

            <Border Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="7" Padding="8">
                <Viewbox Stretch="Uniform" StretchDirection="Both"
                         HorizontalAlignment="Stretch" Height="360">
                    <ItemsControl x:Name="MonitorArrangement" ItemsSource="{Binding Rows}"
                                  Width="900" Height="440">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding PreviewLeft}" />
                                <Setter Property="Canvas.Top" Value="{Binding PreviewTop}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"
                                        Style="{StaticResource MonitorPreviewButtonStyle}"
                                        Click="OnMonitorClick"
                                        PreviewMouseLeftButtonDown="OnMonitorDragStart"
                                        PreviewMouseMove="OnMonitorDragMove"
                                        PreviewMouseLeftButtonUp="OnMonitorDragEnd"
                                        LostMouseCapture="OnMonitorLostMouseCapture"
                                        AutomationProperties.Name="{Binding MonitorName}"
                                        ToolTip="Select to edit, or drag to snap beside another enabled monitor">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MonitorName}" FontWeight="SemiBold" FontSize="20"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SecondaryInformation}" FontSize="10"
                                                   Margin="0,2,0,0" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>
            </Border>
        </StackPanel>
    </shells:ConfigurationPageShell.EditorContent>

    <shells:ConfigurationPageShell.SecondaryEditorContent>
        <Border x:Name="MonitorEditorCard" Style="{StaticResource CardStyle}"
                DataContext="{Binding SelectedMonitor}"
                Visibility="{Binding DataContext.HasMonitors, RelativeSource={RelativeSource AncestorType=shells:ConfigurationPageShell}, Converter={StaticResource BooleanToVisibility}}">
            <Expander x:Name="MonitorSettingsExpander" IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="Monitor settings" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                </Expander.Header>
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="{Binding MonitorName}" Style="{StaticResource SectionTitleStyle}"
                               Margin="0,3,0,2" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SecondaryInformation}" Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,0,0,3" />
                    <TextBlock Text="Resolution is reported by Windows and is informational only."
                               Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Margin="0,0,0,14" />

                    <WrapPanel Margin="0,0,0,14">
                        <CheckBox Content="Enabled in this layout" IsChecked="{Binding Included, Mode=TwoWay}"
                                  Margin="0,0,22,8" />
                        <CheckBox Content="Primary monitor" IsChecked="{Binding Primary, Mode=TwoWay}"
                                  IsEnabled="{Binding Included}" Margin="0,0,0,8" />
                    </WrapPanel>

                    <StackPanel IsEnabled="{Binding Included}">
                        <StackPanel Visibility="{Binding Primary, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Position" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="Place this monitor relative to another enabled monitor. The preview updates immediately."
                                       Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                                       Margin="0,3,0,8" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,0,0,14">
                                <ComboBox Width="150" Margin="0,0,8,8"
                                          ItemsSource="{Binding DirectionOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Direction, Mode=TwoWay}" />
                                <ComboBox Width="210" Margin="0,0,0,8"
                                          ItemsSource="{Binding AnchorChoices}"
                                          SelectedItem="{Binding Anchor, Mode=TwoWay}" />
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock Text="Refresh rate" Style="{StaticResource EyebrowTextStyle}" />
                        <ComboBox Width="210" HorizontalAlignment="Left" Margin="0,6,0,0"
                                  ItemsSource="{Binding RefreshChoices}"
                                  SelectedItem="{Binding SelectedRefresh, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </Border>
    </shells:ConfigurationPageShell.SecondaryEditorContent>

</shells:ConfigurationPageShell>
