<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shells="clr-namespace:PCMode.Tray.Controls.PageShells">

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PageDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>

    <!-- The one place that owns the universal page header and outer margin. -->
    <Style TargetType="{x:Type shells:CommonPageShell}">
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shells:CommonPageShell}">
                    <Grid Margin="{DynamicResource PageMargin}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    Text="{TemplateBinding PageTitle}"
                                    Style="{StaticResource PageTitleStyle}" />
                                <TextBlock
                                    Text="{TemplateBinding PageDescription}"
                                    Style="{StaticResource PageDescriptionStyle}" />
                            </StackPanel>
                            <ContentPresenter
                                Grid.Column="1"
                                Content="{TemplateBinding HeaderActionContent}"
                                VerticalAlignment="Top"
                                Margin="16,0,0,0">
                                <ContentPresenter.Style>
                                    <Style TargetType="ContentPresenter">
                                        <Style.Triggers>
                                            <Trigger Property="Content" Value="{x:Null}">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Setter Property="Margin"
                                                        Value="0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentPresenter.Style>
                            </ContentPresenter>
                        </Grid>

                        <!-- Main page content -->
                        <ContentPresenter
                            Grid.Row="1"
                            Content="{TemplateBinding Content}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        <!-- Footer -->
                        <ContentPresenter
                            Grid.Row="2"
                            Content="{TemplateBinding FooterContent}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A list page reuses CommonPageShell instead of duplicating its header. -->
    <Style TargetType="{x:Type shells:ListPageShell}">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shells:ListPageShell}">
                    <shells:CommonPageShell PageTitle="{TemplateBinding PageTitle}"
                                            PageDescription="{TemplateBinding PageDescription}"
                                            HeaderActionContent="{TemplateBinding HeaderActionContent}"
                                            FooterContent="{TemplateBinding FooterContent}"
                                            Foreground="{TemplateBinding Foreground}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                        </ScrollViewer>
                    </shells:CommonPageShell>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageScrollStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="PageSectionHeaderStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="PageSectionSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="PageSubsectionTitleStyle"
        TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Margin"
                Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSubsectionDescriptionStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource MutedTextStyle}">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="Margin"
                Value="0,0,0,8" />
    </Style>

    <Style x:Key="PageBinaryChoiceRowStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <Style x:Key="PageInlineDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Margin" Value="0,18,0,16" />
    </Style>

    <Style x:Key="PageAddRowButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="PageUnitSuffixTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ExpanderMinorHeaderStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MutedTextStyle}" />

           <Thickness x:Key="PageFooterMargin">0,18,0,0</Thickness>

</ResourceDictionary>
