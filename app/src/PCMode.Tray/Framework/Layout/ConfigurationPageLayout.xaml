<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shells="clr-namespace:PCMode.Tray.Controls.PageShells"
    xmlns:components="clr-namespace:PCMode.Tray.Controls.Components">

    <!-- ============================================================
         CONFIGURATION GEOMETRY
         ============================================================ -->

    <GridLength x:Key="ConfigurationSelectorWidth">280</GridLength>
    <GridLength x:Key="ConfigurationColumnGap">18</GridLength>


    <!-- ============================================================
         HEADER
         ============================================================ -->

    <Style x:Key="ConfigurationHeaderSummaryStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MutedTextStyle}">

        <Setter Property="TextWrapping" Value="Wrap" />

        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>

    </Style>


    <Style x:Key="ConfigurationHeaderStatusStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MutedTextStyle}">

        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />

        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Margin" Value="0" />
            </Trigger>
        </Style.Triggers>

    </Style>


    <Style x:Key="ConfigurationHeaderErrorStyle"
           TargetType="TextBlock">

        <Setter Property="Foreground"
                Value="{DynamicResource ErrorBrush}" />

        <Setter Property="TextWrapping"
                Value="Wrap" />

        <Setter Property="Margin"
                Value="0,8,0,0" />

        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Margin" Value="0" />
            </Trigger>
        </Style.Triggers>

    </Style>


    <!-- ============================================================
         SELECTOR
         ============================================================ -->

    <Style x:Key="ConfigurationSelectorCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardStyle}">

        <Setter Property="Padding" Value="0" />

    </Style>


    <Style x:Key="ConfigurationSelectorHeaderStyle"
           TargetType="Grid">

        <Setter Property="Margin"
                Value="16,14,12,10" />

    </Style>


    <Style x:Key="ConfigurationSelectorTitleStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SectionTitleStyle}">

        <Setter Property="Margin" Value="0" />

    </Style>


    <Style x:Key="ConfigurationSelectorSubtitleStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MutedTextStyle}">

        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,2,0,0" />

        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Margin" Value="0" />
            </Trigger>
        </Style.Triggers>

    </Style>


    <Style x:Key="ConfigurationSelectorSeparatorStyle"
           TargetType="Border">

        <Setter Property="Height" Value="1" />

        <Setter Property="Background"
                Value="{DynamicResource BorderBrush}" />

    </Style>


    <Style x:Key="ConfigurationSelectorListStyle"
           TargetType="ListBox">

        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="Background"
                Value="Transparent" />

        <Setter Property="Foreground"
                Value="{DynamicResource ForegroundBrush}" />

        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />

        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Disabled" />

        <Setter Property="Padding"
                Value="0,4,0,8" />

    </Style>


    <Style x:Key="ConfigurationSelectorItemContainerStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource FlatSelectionItemStyle}">

        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />

        <Setter Property="VerticalContentAlignment"
                Value="Center" />

    </Style>

    <!-- ============================================================
         EDITOR
         ============================================================ -->

    <Style x:Key="ConfigurationEditorContentStyle"
           TargetType="StackPanel">

        <Setter Property="HorizontalAlignment"
                Value="Stretch" />

    </Style>


    <Style x:Key="ConfigurationEditorActionRowStyle"
           TargetType="StackPanel">

        <Setter Property="Orientation"
                Value="Horizontal" />

        <Setter Property="VerticalAlignment"
                Value="Top" />

        <Setter Property="Margin"
                Value="16,0,0,0" />

    </Style>


    <Style x:Key="ConfigurationSecondaryEditorPresenterStyle"
           TargetType="ContentPresenter">

        <Setter Property="HorizontalAlignment"
                Value="Stretch" />

        <Setter Property="Margin"
                Value="0,14,0,0" />

        <Style.Triggers>

            <Trigger Property="Content"
                     Value="{x:Null}">

                <Setter Property="Visibility"
                        Value="Collapsed" />

                <Setter Property="Margin"
                        Value="0" />

            </Trigger>

        </Style.Triggers>

    </Style>


    <!-- ============================================================
         FOOTER
         ============================================================ -->

    <Style x:Key="ConfigurationPageFooterStyle"
           TargetType="StackPanel">

        <Setter Property="Orientation"
                Value="Horizontal" />

        <Setter Property="HorizontalAlignment"
                Value="Right" />

        <Setter Property="Margin"
                Value="{StaticResource PageFooterMargin}" />

    </Style>


    <!-- ============================================================
         CONFIGURATION PAGE SHELL
         ============================================================ -->

    <Style TargetType="{x:Type shells:ConfigurationPageShell}">

        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />

        <Setter Property="VerticalContentAlignment"
                Value="Stretch" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type shells:ConfigurationPageShell}">


                    <shells:CommonPageShell
                        PageTitle="{TemplateBinding PageTitle}"
                        PageDescription="{TemplateBinding PageDescription}"
                        HeaderActionContent="{TemplateBinding HeaderActionContent}">


                        <!-- ============================= -->
                        <!-- FOOTER                        -->
                        <!-- ============================= -->

                        <shells:CommonPageShell.FooterContent>

                            <StackPanel
                                Style="{StaticResource ConfigurationPageFooterStyle}"
                                Visibility="{Binding ShowFooter,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    Converter={StaticResource BooleanToVisibility}}">

                                <TextBlock
                                    Text="{Binding ValidationProblem}"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    MaxWidth="360"
                                    Visibility="{Binding ValidationProblem,
                                        Converter={StaticResource StringToVisibility}}" />

                                <Button
                                    x:Name="PART_DiscardButton"
                                    Content="Discard changes"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanDiscard}" />

                                <Button
                                    x:Name="PART_SaveButton"
                                    Content="Save"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding CanSave}" />

                            </StackPanel>

                        </shells:CommonPageShell.FooterContent>


                        <DockPanel>





                            <!-- ============================= -->
                            <!-- SELECTOR + EDITOR              -->
                            <!-- ============================= -->

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="{StaticResource ConfigurationSelectorWidth}" />

                                    <ColumnDefinition
                                        Width="{StaticResource ConfigurationColumnGap}" />

                                    <ColumnDefinition
                                        Width="*" />

                                </Grid.ColumnDefinitions>


                                <!-- ========================= -->
                                <!-- SELECTOR                  -->
                                <!-- ========================= -->

                                <Border
                                    Style="{StaticResource ConfigurationSelectorCardStyle}">

                                    <DockPanel>


                                        <Grid
                                            DockPanel.Dock="Top"
                                            Style="{StaticResource ConfigurationSelectorHeaderStyle}">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="Auto" />

                                            </Grid.ColumnDefinitions>


                                            <StackPanel>

                                                <TextBlock
                                                    Text="{TemplateBinding SelectorTitle}"
                                                    Style="{StaticResource ConfigurationSelectorTitleStyle}" />

                                                <TextBlock
                                                    Text="{TemplateBinding SelectorDescription}"
                                                    Style="{StaticResource ConfigurationSelectorSubtitleStyle}" />

                                            </StackPanel>


                                            <Button
                                                x:Name="PART_CreateButton"
                                                Grid.Column="1"
                                                Content="Create"
                                                Style="{StaticResource CompactSecondaryButtonStyle}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ShowCreateButton,
                                                    RelativeSource={RelativeSource TemplatedParent},
                                                    Converter={StaticResource BooleanToVisibility}}" />

                                        </Grid>


                                        <Border
                                            DockPanel.Dock="Top"
                                            Style="{StaticResource ConfigurationSelectorSeparatorStyle}" />


                                        <ListBox
                                            x:Name="PART_SelectorList"
                                            ItemsSource="{TemplateBinding SelectorItemsSource}"
                                            SelectedItem="{Binding SelectorSelectedItem,
                                                RelativeSource={RelativeSource TemplatedParent},
                                                Mode=TwoWay}"
                                            ItemTemplate="{TemplateBinding SelectorItemTemplate}"
                                            ItemContainerStyle="{StaticResource ConfigurationSelectorItemContainerStyle}"
                                            Style="{StaticResource ConfigurationSelectorListStyle}" />


                                    </DockPanel>

                                </Border>


                                <!-- ========================= -->
                                <!-- EDITOR                    -->
                                <!-- ========================= -->

                                <ScrollViewer
                                    Grid.Column="2"
                                    Style="{StaticResource PageScrollStyle}">

                                    <StackPanel
                                        Style="{StaticResource ConfigurationEditorContentStyle}">


                                        <!-- Primary editor card -->

                                        <Border
                                            Style="{StaticResource CardStyle}">

                                            <StackPanel>


                                                <!-- Editor header -->

                                                <Grid
                                                    Style="{StaticResource PageSectionHeaderStyle}">

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="*" />

                                                        <ColumnDefinition Width="Auto" />

                                                    </Grid.ColumnDefinitions>


                                                    <StackPanel>

                                                        <TextBlock
                                                            Text="{TemplateBinding EditorEyebrow}"
                                                            Style="{StaticResource EyebrowTextStyle}" />

                                                        <TextBlock
                                                            Text="{TemplateBinding EditorTitle}"
                                                            Style="{StaticResource SectionTitleStyle}"
                                                            Margin="0,2,0,0"
                                                            TextWrapping="Wrap" />

                                                    </StackPanel>


                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Style="{StaticResource ConfigurationEditorActionRowStyle}">


                                                        <Button
                                                            x:Name="PART_ActionsButton"
                                                            Content="Actions"
                                                            Style="{StaticResource CompactSecondaryButtonStyle}"
                                                            Margin="0,2,8,0"
                                                            IsEnabled="{TemplateBinding CanUseActions}"
                                                            ContextMenu="{TemplateBinding ActionsMenu}" />


                                                        <Button
                                                            x:Name="PART_PrimaryActionButton"
                                                            Content="{TemplateBinding PrimaryActionLabel}"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            IsEnabled="{TemplateBinding CanUsePrimaryAction}" />


                                                    </StackPanel>

                                                </Grid>


                                                <Border
                                                    Style="{StaticResource PageSectionSeparatorStyle}" />


                                                <!-- Page-specific editor -->

                                                <ContentPresenter
                                                    Content="{TemplateBinding EditorContent}" />


                                            </StackPanel>

                                        </Border>


                                        <!-- Optional extra cards/content -->

                                        <ContentPresenter
                                            Content="{TemplateBinding SecondaryEditorContent}"
                                            Style="{StaticResource ConfigurationSecondaryEditorPresenterStyle}" />


                                    </StackPanel>

                                </ScrollViewer>


                            </Grid>

                        </DockPanel>


                    </shells:CommonPageShell>


                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>