<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:components="clr-namespace:PCMode.Tray.Controls.Components">

    <Style TargetType="{x:Type components:PageSection}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:PageSection}">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>

                            <TextBlock
                                Text="{TemplateBinding Title}"
                                Style="{StaticResource SectionTitleStyle}"
                                Margin="0,0,0,14" />

                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Stretch" />

                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type components:FieldRow}">
        <Setter Property="Foreground"
                Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:FieldRow}">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{DynamicResource FieldLabelWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{TemplateBinding Label}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="{TemplateBinding LabelVerticalAlignment}" />
                        <StackPanel Grid.Column="1">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            <TextBlock
                                x:Name="HintText"
                                Text="{TemplateBinding Hint}"
                                Style="{StaticResource MutedTextStyle}"
                                Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Hint" Value="">
                            <Setter TargetName="HintText"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Hint" Value="{x:Null}">
                            <Setter TargetName="HintText"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type components:BrowseFileRow}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:BrowseFileRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Text="{Binding Text,
                                        RelativeSource={RelativeSource TemplatedParent},
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{TemplateBinding ToolTipText}" />
                        <Button
                            x:Name="PART_BrowseButton"
                            Grid.Column="1"
                            Content="Browse..."
                            Style="{StaticResource CompactSecondaryButtonStyle}"
                            Margin="8,0,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ConfigurationSelectorItemTitleStyle"
           TargetType="TextBlock">

        <Setter Property="FontWeight"
                Value="SemiBold" />

        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />

        <Setter Property="VerticalAlignment"
                Value="Center" />

    </Style>


    <Style x:Key="ConfigurationSelectorBadgeStyle"
           TargetType="Border">

        <Setter Property="Background"
                Value="{DynamicResource AccentBrush}" />

        <Setter Property="CornerRadius"
                Value="8" />

        <Setter Property="Padding"
                Value="6,2" />

        <Setter Property="Margin"
                Value="8,0,0,0" />

        <Setter Property="VerticalAlignment"
                Value="Center" />

    </Style>


    <Style x:Key="ConfigurationSelectorBadgeTextStyle"
           TargetType="TextBlock">

        <Setter Property="Foreground"
                Value="{DynamicResource AccentTextBrush}" />

        <Setter Property="FontSize"
                Value="10" />

        <Setter Property="FontWeight"
                Value="SemiBold" />

    </Style>

    <Style TargetType="{x:Type components:ConfigurationSelectorItem}">
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="{x:Type components:ConfigurationSelectorItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{TemplateBinding Title}"
                            Style="{StaticResource ConfigurationSelectorItemTitleStyle}" />
                        <Border
                            x:Name="PART_Badge"
                            Grid.Column="1"
                            Style="{StaticResource ConfigurationSelectorBadgeStyle}">
                            <TextBlock
                                Text="{TemplateBinding BadgeText}"
                                Style="{StaticResource ConfigurationSelectorBadgeTextStyle}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsBadgeVisible"
                                 Value="False">
                            <Setter
                                TargetName="PART_Badge"
                                Property="Visibility"
                                Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type components:StatusDot}">

        <Setter Property="Width"
                Value="8" />

        <Setter Property="Height"
                Value="8" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type components:StatusDot}">

                    <Ellipse
                        x:Name="Dot"
                        Fill="{DynamicResource MutedForegroundBrush}" />

                    <ControlTemplate.Triggers>

                        <Trigger Property="State"
                                Value="Ok">

                            <Setter
                                TargetName="Dot"
                                Property="Fill"
                                Value="{DynamicResource SuccessBrush}" />

                        </Trigger>

                        <Trigger Property="State"
                                Value="Warning">

                            <Setter
                                TargetName="Dot"
                                Property="Fill"
                                Value="{DynamicResource WarningBrush}" />

                        </Trigger>

                        <Trigger Property="State"
                                Value="Error">

                            <Setter
                                TargetName="Dot"
                                Property="Fill"
                                Value="{DynamicResource ErrorBrush}" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <Style TargetType="{x:Type components:RemovableRow}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:RemovableRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        <Button
                            x:Name="PART_RemoveButton"
                            Grid.Column="1"
                            Content="Remove"
                            Style="{StaticResource CompactSecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
