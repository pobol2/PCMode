<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PCMode.Tray</RootNamespace>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\PCMode.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\PCMode.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCMode.Engine\PCMode.Engine.csproj" />
    <ProjectReference Include="..\PCMode.Picker\PCMode.Picker.csproj" />
  </ItemGroup>

</Project>
