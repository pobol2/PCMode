[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=08/20/2026,1.0.0.0
CatalogFile=PCMode.Audio.VirtualEndpoint.cat
PnpLockDown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
PCMode.Audio.VirtualEndpoint.sys=1

[Manufacturer]
%ManufacturerName%=PCMode,NTamd64.10.0...22000

[PCMode.NTamd64.10.0...22000]
%PCModeAudio.DeviceDesc%=PCModeAudio_Device,ROOT\PCMODEAUDIO

[PCModeAudio_Device.NT]
CopyFiles=PCModeAudio.Copy

[PCModeAudio.Copy]
PCMode.Audio.VirtualEndpoint.sys

[PCModeAudio_Device.NT.Services]
AddService=PCModeAudio,0x00000002,PCModeAudio_Service

[PCModeAudio_Service]
DisplayName=%PCModeAudio.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\PCMode.Audio.VirtualEndpoint.sys

[PCModeAudio_Device.NT.Wdf]
KmdfService=PCModeAudio,PCModeAudio_Wdf

[PCModeAudio_Wdf]
KmdfLibraryVersion=$KMDFVERSION$

;
; ACX render interface.
;
[PCModeAudio_Device.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,PCModeAudio.Render

[PCModeAudio.Render]
AddReg=PCModeAudio.Render.AddReg

[PCModeAudio.Render.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%PCModeAudio.EndpointName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[Strings]
ProviderName="PCMode"
ManufacturerName="PCMode"
DiskName="PCMode Audio Driver Installation Media"

PCModeAudio.DeviceDesc="PCMode Virtual Audio Endpoint"
PCModeAudio.ServiceDesc="PCMode Virtual Audio Endpoint Driver"
PCModeAudio.EndpointName="PCMode Audio"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"

KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSNAME_Wave="Wave"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFE56C6E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode="{1DA5D803-D492-4EDD-8C23-E0C0FFE56C6E},7"
