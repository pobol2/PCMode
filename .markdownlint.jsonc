// Markdown policy for PCMode. Whitespace, indentation and line endings come
// from .editorconfig; this file covers only what .editorconfig cannot express.
{
    "default": true,

    // The prose in this repository is written one paragraph per line and soft
    // wrapped by the editor. Enforcing a column limit here would mean rewriting
    // the documents, which is a change to the documents and not to formatting.
    "MD013": false,

    // A handful of documents use inline HTML for tables and anchors.
    "MD033": false,

    // Duplicate headings are legitimate under different parents.
    "MD024": { "siblings_only": true }
}
